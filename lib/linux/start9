#!/bin/sh
# attempt to prevent journal corruption, in case kexec -r is used
# mount -t tmpfs -o size=64M tmpfs /var/log/journal

# You can override ea=525400deadbe if necessary, but currently
# U-Boot reads the K1 efuse chip-id, derives the per-port MAC, 
# writes it into the MAC_ADDR1_HI/ME/LO registers, and the 9 kernel reads it.
# Assume the right version of kexec is in the path: e.g. put it in /usr/local/bin or so
# /tmp/9bpif3.elf is good to avoid sd card writes if you are doing kernel dev; otherwise figure out where you want it
# maxmem comes from DTB but can be overridden
kexec -b "console=0" /tmp/9bpif3.elf


APE=/sys/src/ape
objtype=riscv64
<$APE/config
LIB=/$objtype/lib/ape/libap.a

# memset intentionally omitted: use portable gen/memset.c.
# the hand-written memset.s read the length as 8 bytes, but jc packs
# int/size_t args in 4-byte slots, so it overran the stack.

OFILES=\
	argv0.$O\
	cycles.$O\
	getcallerpc.$O\
	getfcr.$O\
	lock.$O\
	main9.$O\
	main9p.$O\
#	malloc.$O\
#	memccpy.$O\
#	memchr.$O\
#	memcmp.$O\
#	memmove.$O\
#	memset.$O\
	notetramp.$O\
	_seek.$O\
	setjmp.$O\
#	sqrt.$O\
#	strchr.$O\
#	strcmp.$O\
#	strcpy.$O\
	tas.$O\

</sys/src/cmd/mksyslib

CFLAGS=$CFLAGS -c -D_POSIX_SOURCE -D_PLAN9_SOURCE

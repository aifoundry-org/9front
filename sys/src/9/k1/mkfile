CONF=bpif3
CONFLIST=bpif3 bpif3cpuwait

# SpacemiT K1 (Banana Pi BPI-F3): the generic kernel in ../rva23 with
# the K1's ethernet, SD/eMMC and USB drivers, its thermal sensor and
# fan, and its PMIC reset and power off.  The board file (bpif3board.c)
# is named in the configuration.
#
# loadaddr is the link address (-T), but the kernel runs in place
# wherever kexec/booti put it, fixing up its data pointers from the
# jl -u relocation table and binding memory layout to _start runtime address.
# CPU type		RAM base
# BPI-F3 2/4GB	0x40000000; some lower RAM reserved for firmware
# BPI-F3 > 4GB	ditto, plus second block at 0x100000000
loadaddr=0x102202000

objtype=riscv64
</$objtype/mkfile

SOCOBJ=\
	nopci.$O\
	k1reset.$O\
	k1thermal.$O\
	fan.$O\

<../rva23/socmkfile

bpif3cpuwait: bpif3
	cp $prereq $target

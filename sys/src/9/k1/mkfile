CONF=bpif3
CONFLIST=bpif3 bpif3cpuwait

# SpacemiT K1 (Banana Pi BPI-F3): the generic kernel in ../rva23 with
# the K1's ethernet, SD/eMMC and USB drivers, its thermal sensor and
# fan, and its PMIC reset and power off.  The board file (bpif3board.c)
# is named in the configuration.
#
# loadaddr is the link address (-T), but the kernel runs in place
# wherever kexec/booti put it, fixing up its data pointers from the
# jl -u relocation table and binding memory layout to _start runtime address.
# CPU type		RAM base
# BPI-F3 2/4GB	0x40000000; some lower RAM reserved for firmware
# BPI-F3 > 4GB	ditto, plus second block at 0x100000000
loadaddr=0x102202000

objtype=riscv64
</$objtype/mkfile

CFLAGS=-I. -I../rva23 $CFLAGS

p=9

DEVS=`{rc ../port/mkdevlist $CONF}

PORT=\
	alarm.$O\
	alloc.$O\
	allocb.$O\
	auth.$O\
	cache.$O\
	chan.$O\
	dev.$O\
	edf.$O\
	fault.$O\
	mul64fract.$O\
	page.$O\
	parse.$O\
	pgrp.$O\
	portclock.$O\
	print.$O\
	proc.$O\
	qio.$O\
	qlock.$O\
	random.$O\
	rdb.$O\
	rebootcmd.$O\
	segment.$O\
	syscallfmt.$O\
	sysfile.$O\
	sysproc.$O\
	taslock.$O\
	tod.$O\
	ucalloc.$O\
	xalloc.$O\
	userinit.$O\

# l.$O must always be first
OBJ=\
	l.$O\
	cas.$O\
	timecmp.$O\
	reloc.$O\
	archrv.$O\
	cbo.$O\
	bootargs.$O\
	strap.$O\
	main.$O\
	mmu.$O\
	mem.$O\
	memmap.$O\
	plic.$O\
	aplic.$O\
	intr.$O\
	trap.$O\
	clock.$O\
	fp.$O\
	fpu.$O\
	sbi.$O\
	sbicall.$O\
	sbiecall.$O\
	nopci.$O\
	k1reset.$O\
	k1thermal.$O\
	fan.$O\
	$CONF.root.$O\
	$CONF.rootc.$O\
	$DEVS\
	$PORT\

HFILES=\
	../rva23/mem.h\
	../rva23/dat.h\
	../rva23/fns.h\
	../rva23/io.h\
	../rva23/riscv64.h\

LIB=\
	/$objtype/lib/libmemlayer.a\
	/$objtype/lib/libmemdraw.a\
	/$objtype/lib/libdraw.a\
	/$objtype/lib/libip.a\
	/$objtype/lib/libsec.a\
	/$objtype/lib/libmp.a\
	/$objtype/lib/libc.a\
	/$objtype/lib/libdtracy.a\

9:V:	$p$CONF s$p$CONF

bpif3cpuwait: bpif3
	cp $prereq $target

$p$CONF $p$CONF.elf $p$CONF.elf.sym:D:	$OBJ $CONF.$O $LIB
	$LD -s -l -u -o $p$CONF -H6 -R0x1000 -T$loadaddr $prereq
	# ELF for kexec
	$LD -s -l -u -o $p$CONF.elf -H5 -R4 -T$loadaddr $prereq
	# ELF with symbols, for gdb
	$LD -l -u -o $p$CONF.elf.sym -H5 -R4 -T$loadaddr $prereq

s$p$CONF:D:	$OBJ $CONF.$O $LIB
	$LD -l -o $target -R0x1000 -T$loadaddr $prereq
	size $target

$OBJ: $HFILES

install:V: /$objtype/$p$CONF

/$objtype/$p$CONF:D: $p$CONF s$p$CONF $p$CONF.elf $p$CONF.elf.sym
	cp -x $prereq /$objtype/

# mk install.9fat: copy 9$CONF to the 9fat partition for u-boot; old one to 9$CONF.o
install.%:V:	$p$CONF
	@{
	rfork n
	9fs $stem
	test -e /n/$stem/$p$CONF && cp /n/$stem/$p$CONF /n/$stem/$p$CONF.o
	cp $p$CONF /n/$stem/$p$CONF
	}

# the rva23 files this directory does not replace
# (memmap.c also names a ../port file, so it gets its own rule)
RVA23FILES=`{../port/mkfilelist ../rva23 | sed 's/(^|\|)memmap(\||$)/\1/'}
^($RVA23FILES)\.$O:R:	'../rva23/\1.c'
	$CC $CFLAGS -. ../rva23/$stem1.c

memmap.$O:	../rva23/memmap.c
	$CC $CFLAGS -. ../rva23/memmap.c

l.$O:	../rva23/l.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/l.s
cas.$O:	../rva23/cas.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/cas.s
timecmp.$O:	../rva23/timecmp.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/timecmp.s
strap.$O:	../rva23/strap.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/strap.s
fp.$O:	../rva23/fp.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/fp.s
sbiecall.$O:	../rva23/sbiecall.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/sbiecall.s
init9.$O:	../rva23/init9.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/init9.s

<../boot/bootmkfile
<../port/portmkfile
<|../port/mkbootrules $CONF

initcode.out:		init9.$O initcode.$O /$objtype/lib/libc.a
	$LD -l -R1  -o $target $prereq

$CONF.clean:
	rm -rf $p$CONF $p$CONF.elf $p$CONF.elf.sym s$p$CONF errstr.h $CONF.c boot$CONF.c

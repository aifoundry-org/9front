#!/bin/rc
# Diskless, single-hart bring-up: no storage/network/DMA probes.
if(~ $#user 0)
	user=glenda
echo -n $user >/dev/hostowner
bind -qa '#t' /dev
bind -qa '#P' /dev
bind '#p' /proc
bind -a '#r' /dev
# the clock is UTC (devrtc.c); there is no /adm/timezone
if(! test -e /env/timezone)
	echo 'GMT 0 GMT 0' >/env/timezone
aux/kbdfs -q -s cons /dev/eia0
ramfs -m /tmp
prompt=('maxion9% ' '	')
echo '9front Maxion RAM-root ready'
echo 'No persistent disk, DMA, or SMP.'
# Raw IP point-to-point link to the PCIe host over the SP packet
# mailbox, present only when the host bootstrap described it in the DT.
bind -a '#I' /net
bind -qa '#E' /dev
if(test -e /dev/mxpctl){
	if(~ $#mxpip 0)
		mxpip=192.0.2.2
	if(~ $#mxppeer 0)
		mxppeer=192.0.2.1
	<>/net/ipifc/clone {
		echo bind netdev /dev/mxp >[1=0] &&
		echo add $mxpip 255.255.255.255 $mxppeer 1500 >[1=0] &&
		echo 'mxp: '^$mxpip^' <-> '^$mxppeer^' over the host packet mailbox'
	}
	# ntp=addr: discipline the clock against an NTP server across the link
	if(! ~ $#ntp 0){
		aux/timesync -n 'udp!'^$ntp^'!123' &
		echo 'timesync: ntp udp!'^$ntp^'!123'
	}
}
if not
	echo 'mxp: no packet mailbox bootstrap; network absent'
smoke
exec /bin/rc -i </dev/cons >/dev/cons >[2=1]

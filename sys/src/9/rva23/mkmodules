# SoC support modules.  Each lives in ../rva23/<module>, compiles
# against the including kernel's headers (-I.), and is linked in by
# its conf misc entry, which also puts its Socmod in knownsoc[]:
#	misc
#		sock1	k1reset k1thermal
# Object names are shared across modules; mk refuses duplicates.

%.$O:	../rva23/k1/%.c
	$CC $CFLAGS -I. ../rva23/k1/$stem.c

%.$O:	../rva23/k3/%.c
	$CC $CFLAGS -I. ../rva23/k3/$stem.c

%.$O:	../rva23/virt/%.c
	$CC $CFLAGS -I. ../rva23/virt/$stem.c

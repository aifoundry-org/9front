CONF=rva23
CONFLIST=rva23 rva23cpuwait

# loadaddr is the link address (-T), but the kernel runs in place
# wherever kexec/booti put it: _start calls _reloc (see 2l(1)) and
# the memory layout hangs off the run-time address of _start.
# CPU type		RAM base
# qemu-virt		0x80000000
# BPI-F3 2/4GB  0x40000000; some lower RAM reserved for firmware
# BPI-F3 > 4GB	ditto, plus second block at 0x100000000
# K3 (all)		0x100000000, all available
loadaddr=0x102202000

objtype=riscv64
</$objtype/mkfile

p=9

DEVS=`{rc ../port/mkdevlist $CONF}

PORT=\
	alarm.$O\
	alloc.$O\
	allocb.$O\
	auth.$O\
	cache.$O\
	chan.$O\
	dev.$O\
	edf.$O\
	fault.$O\
	mul64fract.$O\
	page.$O\
	parse.$O\
	pgrp.$O\
	portclock.$O\
	print.$O\
	proc.$O\
	qio.$O\
	qlock.$O\
	random.$O\
	rdb.$O\
	rebootcmd.$O\
	segment.$O\
	syscallfmt.$O\
	sysfile.$O\
	sysproc.$O\
	taslock.$O\
	tod.$O\
	ucalloc.$O\
	xalloc.$O\
	userinit.$O\

# don't forget: l.$O must always be first
OBJ=\
	l.$O\
	cas.$O\
	timecmp.$O\
	archrv.$O\
	cbo.$O\
	bootargs.$O\
	strap.$O\
	main.$O\
	mmu.$O\
	mem.$O\
	addrmap.$O\
	plic.$O\
	aplic.$O\
	intr.$O\
	trap.$O\
	clock.$O\
	fp.$O\
	fpu.$O\
	sbi.$O\
	sbicall.$O\
	sbiecall.$O\
	fan.$O\
	$CONF.root.$O\
	$CONF.rootc.$O\
	$DEVS\
	$PORT\

# HFILES=

LIB=\
	/$objtype/lib/libmemlayer.a\
	/$objtype/lib/libmemdraw.a\
	/$objtype/lib/libdraw.a\
	/$objtype/lib/libip.a\
	/$objtype/lib/libsec.a\
	/$objtype/lib/libmp.a\
	/$objtype/lib/libc.a\
	/$objtype/lib/libdtracy.a\

9:V:	$p$CONF s$p$CONF

rva23cpuwait: rva23
	cp $prereq $target

$p$CONF $p$CONF.elf $p$CONF.elf.sym:D:	$OBJ $CONF.$O $LIB
	$LD -s -l -o $p$CONF -H6 -R0x1000 -T$loadaddr $prereq
	# ELF for kexec
	$LD -s -l -o $p$CONF.elf -H5 -R4 -T$loadaddr $prereq
	# ELF with symbols, for source-level gdb-on-qemu
	$LD -l -o $p$CONF.elf.sym -H5 -R4 -T$loadaddr $prereq

s$p$CONF:D:	$OBJ $CONF.$O $LIB
	$LD -l -o $target -R0x1000 -T$loadaddr $prereq
	size $target

$OBJ: $HFILES

install:V: /$objtype/$p$CONF

/$objtype/$p$CONF:D: $p$CONF s$p$CONF $p$CONF.elf $p$CONF.elf.sym
	cp -x $prereq /$objtype/

# mk install.9fat: copy 9rva23 to 9fat partition for u-boot; backup to 9rva23.o
install.%:V:	$p$CONF
	@{
	rfork n
	9fs $stem
	test -e /n/$stem/$p$CONF && cp /n/$stem/$p$CONF /n/$stem/$p$CONF.o
	cp $p$CONF /n/$stem/$p$CONF
	}

<mkmodules
<../boot/bootmkfile
<../port/portmkfile
<|../port/mkbootrules $CONF

#main.$O: rebootcode.i

pciqemu.$O: ../port/pci.h

initcode.out:		init9.$O initcode.$O /$objtype/lib/libc.a
	$LD -l -R1  -o $target $prereq

#rebootcode.out:		rebootcode.$O cache.v8.$O
#	$LD -l -H6 -R1 -T0x40020000 -s -o $target $prereq

$CONF.clean:
	rm -rf $p$CONF $p$CONF.elf $p$CONF.elf.sym s$p$CONF errstr.h $CONF.c boot$CONF.c

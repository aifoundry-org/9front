# The kernel build shared by ../rva23 and the SoC directories.  The
# including mkfile sets CONF, CONFLIST, loadaddr and objtype, reads
# /$objtype/mkfile and lists its own objects in SOCOBJ.

p=9

DEVS=`{rc ../port/mkdevlist $CONF}

PORT=\
	alarm.$O\
	alloc.$O\
	allocb.$O\
	auth.$O\
	cache.$O\
	chan.$O\
	dev.$O\
	edf.$O\
	fault.$O\
	mul64fract.$O\
	page.$O\
	parse.$O\
	pgrp.$O\
	portclock.$O\
	print.$O\
	proc.$O\
	qio.$O\
	qlock.$O\
	random.$O\
	rdb.$O\
	rebootcmd.$O\
	segment.$O\
	syscallfmt.$O\
	sysfile.$O\
	sysproc.$O\
	taslock.$O\
	tod.$O\
	ucalloc.$O\
	xalloc.$O\
	userinit.$O\

# don't forget: l.$O must always be first
OBJ=\
	l.$O\
	cas.$O\
	timecmp.$O\
	reloc.$O\
	archrv.$O\
	cbo.$O\
	bootargs.$O\
	strap.$O\
	main.$O\
	mmu.$O\
	mem.$O\
	memmap.$O\
	plic.$O\
	aplic.$O\
	intr.$O\
	trap.$O\
	clock.$O\
	fp.$O\
	fpu.$O\
	sbi.$O\
	sbicall.$O\
	sbiecall.$O\
	$SOCOBJ\
	$CONF.root.$O\
	$CONF.rootc.$O\
	$DEVS\
	$PORT\

LIB=\
	/$objtype/lib/libmemlayer.a\
	/$objtype/lib/libmemdraw.a\
	/$objtype/lib/libdraw.a\
	/$objtype/lib/libip.a\
	/$objtype/lib/libsec.a\
	/$objtype/lib/libmp.a\
	/$objtype/lib/libc.a\
	/$objtype/lib/libdtracy.a\

9:V:	$p$CONF s$p$CONF

$p$CONF $p$CONF.elf $p$CONF.elf.sym:D:	$OBJ $CONF.$O $LIB
	$LD -s -l -u -o $p$CONF -H6 -R0x1000 -T$loadaddr $prereq
	# ELF for kexec
	$LD -s -l -u -o $p$CONF.elf -H5 -R4 -T$loadaddr $prereq
	# ELF with symbols, for source-level gdb-on-qemu
	$LD -l -u -o $p$CONF.elf.sym -H5 -R4 -T$loadaddr $prereq

s$p$CONF:D:	$OBJ $CONF.$O $LIB
	$LD -l -o $target -R0x1000 -T$loadaddr $prereq
	size $target

$OBJ: $HFILES

install:V: /$objtype/$p$CONF

/$objtype/$p$CONF:D: $p$CONF s$p$CONF $p$CONF.elf $p$CONF.elf.sym
	cp -x $prereq /$objtype/

# mk install.9fat: copy 9$CONF to the 9fat partition for u-boot; old one to 9$CONF.o
install.%:V:	$p$CONF
	@{
	rfork n
	9fs $stem
	test -e /n/$stem/$p$CONF && cp /n/$stem/$p$CONF /n/$stem/$p$CONF.o
	cp $p$CONF /n/$stem/$p$CONF
	}

<../boot/bootmkfile
<../port/portmkfile
<|../port/mkbootrules $CONF

#main.$O: rebootcode.i

initcode.out:		init9.$O initcode.$O /$objtype/lib/libc.a
	$LD -l -R1  -o $target $prereq

#rebootcode.out:		rebootcode.$O cache.v8.$O
#	$LD -l -H6 -R1 -T0x40020000 -s -o $target $prereq

$CONF.clean:
	rm -rf $p$CONF $p$CONF.elf $p$CONF.elf.sym s$p$CONF errstr.h $CONF.c boot$CONF.c

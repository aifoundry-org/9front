CONF=picoitx
CONFLIST=picoitx picoitxcpuwait com260 com260cpuwait

# SpacemiT K3: the generic kernel in ../rva23 with the K3's ethernet,
# UFS, I2C, GPIO and thermal drivers and, for each board, its USB,
# display and fan drivers and a board file (picoitxboard.c,
# com260board.c), named in the board's configuration:
#	picoitx	K3 Pico-ITX
#	com260	K3 CoM260 on the IFX carrier
#
# loadaddr is the link address (-T).  The kernel runs wherever it is
# loaded, fixing up its data pointers from the jl -u relocation table
# and binding memory layout to _start's runtime address, but kexec
# loads the ELF at its link address.
# CPU type		RAM base
# K3 (all)		0x100000000, all available
loadaddr=0x102202000

objtype=riscv64
</$objtype/mkfile

SOCOBJ=\
	nopci.$O\
	gpiok3.$O\
	k3thermal.$O\

<../rva23/socmkfile

picoitxcpuwait: picoitx
	cp $prereq $target

com260cpuwait: com260
	cp $prereq $target

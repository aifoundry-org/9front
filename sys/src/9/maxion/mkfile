CONF=maxion
CONFLIST=maxion maxioncpuwait

# Esperanto ET-SoC-1 Maxion: the generic kernel in ../rva23 with this
# SoC's memory map (memmap.c, Sv48), its share of the PLIC (plic.c,
# intr.c), the host's device tree bindings (mxdt.c) and drivers.
# The harts lack Sstc and Zicbom, so it has its own timer (timecmp.c)
# and cache (cbo.c) files.
# OpenSBI starts it in place in the RAM window at 0x8600000000.
# maxioncpuwait is maxion with the cpuwait boot file system.
loadaddr=0x8600200000

objtype=riscv64
</$objtype/mkfile

CFLAGS=-I. -I../rva23 $CFLAGS

p=9

DEVS=`{rc ../port/mkdevlist $CONF}

PORT=\
	alarm.$O\
	alloc.$O\
	allocb.$O\
	auth.$O\
	cache.$O\
	chan.$O\
	dev.$O\
	edf.$O\
	fault.$O\
	mul64fract.$O\
	page.$O\
	parse.$O\
	pgrp.$O\
	portclock.$O\
	print.$O\
	proc.$O\
	qio.$O\
	qlock.$O\
	random.$O\
	rdb.$O\
	rebootcmd.$O\
	segment.$O\
	syscallfmt.$O\
	sysfile.$O\
	sysproc.$O\
	taslock.$O\
	tod.$O\
	ucalloc.$O\
	xalloc.$O\
	userinit.$O\

# l.$O must always be first
OBJ=\
	l.$O\
	cas.$O\
	timecmp.$O\
	archrv.$O\
	cbo.$O\
	bootargs.$O\
	strap.$O\
	main.$O\
	mmu.$O\
	mem.$O\
	memmap.$O\
	mxdt.$O\
	plic.$O\
	intr.$O\
	trap.$O\
	clock.$O\
	fp.$O\
	fpu.$O\
	sbi.$O\
	sbicall.$O\
	sbiecall.$O\
	$CONF.root.$O\
	$CONF.rootc.$O\
	$DEVS\
	$PORT\

HFILES=\
	mem.h\
	../rva23/mem.h\
	../rva23/dat.h\
	../rva23/fns.h\
	../rva23/io.h\
	../rva23/riscv64.h\
	maxion.h\
	mxp.h\

LIB=\
	/$objtype/lib/libmemlayer.a\
	/$objtype/lib/libmemdraw.a\
	/$objtype/lib/libdraw.a\
	/$objtype/lib/libip.a\
	/$objtype/lib/libsec.a\
	/$objtype/lib/libmp.a\
	/$objtype/lib/libc.a\
	/$objtype/lib/libdtracy.a\

9:V:	$p$CONF s$p$CONF

maxioncpuwait: maxion
	cp $prereq $target

$p$CONF $p$CONF.elf $p$CONF.elf.sym:D:	$OBJ $CONF.$O $LIB
	$LD -s -l -u -o $p$CONF -H6 -R0x1000 -T$loadaddr $prereq
	# ELF for kexec and gdb
	$LD -s -l -u -o $p$CONF.elf -H5 -R4 -T$loadaddr $prereq
	$LD -l -u -o $p$CONF.elf.sym -H5 -R4 -T$loadaddr $prereq

s$p$CONF:D:	$OBJ $CONF.$O $LIB
	$LD -l -o $target -R0x1000 -T$loadaddr $prereq
	size $target

$OBJ: $HFILES

install:V: /$objtype/$p$CONF

/$objtype/$p$CONF:D: $p$CONF s$p$CONF $p$CONF.elf $p$CONF.elf.sym
	cp -x $prereq /$objtype/

# the rva23 files this directory does not replace
RVA23FILES=`{../port/mkfilelist ../rva23}
^($RVA23FILES)\.$O:R:	'../rva23/\1.c'
	$CC $CFLAGS -. ../rva23/$stem1.c

l.$O:	../rva23/l.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/l.s
cas.$O:	../rva23/cas.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/cas.s
strap.$O:	../rva23/strap.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/strap.s
fp.$O:	../rva23/fp.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/fp.s
sbiecall.$O:	../rva23/sbiecall.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/sbiecall.s
init9.$O:	../rva23/init9.s
	$AS $AFLAGS -I. -I../rva23 -. ../rva23/init9.s

<../rva23/mkmodules
<../boot/bootmkfile
<../port/portmkfile
<|../port/mkbootrules $CONF

initcode.out:		init9.$O initcode.$O /$objtype/lib/libc.a
	$LD -l -R1  -o $target $prereq

$CONF.clean:
	rm -rf $p$CONF $p$CONF.elf $p$CONF.elf.sym s$p$CONF errstr.h $CONF.c boot$CONF.c

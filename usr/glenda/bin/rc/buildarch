#!/bin/rc
# buildarch [objtype]: rebuild one userland and its kernels
rfork en
bind -a /usr/glenda/bin/rc /bin
path=($path /bin .)

fn fatal {
	echo buildarch: $* failed >[1=2]
	exit $1
}

if(! ~ $#* 0 1){
	echo 'usage: buildarch [objtype]' >[1=2]
	exit usage
}
o=$1
if(~ $#o 0)
	o=$cputype
if(! test -f /$o/mkfile)
	fatal objtype $o

EXTRACOPIES=()
ramfs -m /tmp || fatal ramfs
host=`{sed -n 's/^(AS|CC|LD)=//p' /$cputype/mkfile}
tools=`{sed -n 's/^(AS|CC|LD)=//p' /$o/mkfile}
if(~ $cputype spim)
	host=(va vc vl)
if(~ $o spim)
	tools=(va vc vl)
echo '# tools' $cputype $o
@{
	rfork e
	objtype=$cputype
	cd /sys/src/cmd || exit tools
	mk -s 'DIRS=cc ../libmach '^$"host^' '^$"tools nuke.dirs install.dirs || exit tools
	mk ar.install pcc.install nm.install size.install strip.install file.install || exit tools
} || fatal tools $o

echo '# world' $o
build $o || fatal world $o
# the platforms of /sys/src/9/mkfile's ARCH that build for $o;
# a switch, since a false if would leave buildarch's status false
for(d in `{sed -n 's/^	([a-z0-9]+)\\$/\1/p' /sys/src/9/mkfile}){
	switch(`{sed -n 's/^objtype=//p' /sys/src/9/$d/mkfile}){
	case $o
		platforms=($platforms $d)
	}
}
for(d in $platforms){
	@{cd /sys/src/9/$d && mk clean} || fatal clean $d
	confs=`{sed -n 's/^CONFLIST=//p' /sys/src/9/$d/mkfile}
	if(~ $#confs 0)
		fatal configurations $d
	for(c in $confs){
		echo '# kernel' $c
		kernel -c $c || fatal kernel $c
	}
}
